# .env.example
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=your_jwt_signing_token_here
DATABASE_URL=your_postgresql_supabase_connection_string_here (optional, self-healing memory tables fall back automatically if absent)

# SUPABASE SETTINGS (for standard API integration)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here (highly recommended for admin/organizer bypassing RLS safely on the bypass)

# RAZORPAY INTEGRATION KEY CONFIGURATION
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
